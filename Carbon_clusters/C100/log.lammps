LAMMPS (7 Feb 2024 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
#============Initialization=================
units 			metal
atom_style 		atomic
boundary 		p p p

############################################
#              CLI Variables               #
############################################
variable 		seed index 200093          #
variable 		N index 100                  #
variable 		iter index 1000000         #
variable 		iterther index 100000      #
variable 		iexport index 1000         #
variable 		tempchauf index 3000       #
variable 		Tdamp index 0.001          #
variable 		timestep index 0.0001      #
variable 		box_size index 50		   #
############################################
############################################

#=========Simulation box definition=========
lattice 		sc 1.0
Lattice spacing in x,y,z = 1 1 1
region 			bigbox block 0 ${box_size} 0 ${box_size} 0 ${box_size}
region 			bigbox block 0 50 0 ${box_size} 0 ${box_size}
region 			bigbox block 0 50 0 50 0 ${box_size}
region 			bigbox block 0 50 0 50 0 50
create_box 		1 bigbox
Created orthogonal box = (0 0 0) to (50 50 50)
  1 by 1 by 1 MPI processor grid

#==================Atoms====================
region 			safezone block 20 30 20 30 20 30 units box
create_atoms 	1 random ${N} ${seed} safezone
create_atoms 	1 random 100 ${seed} safezone
create_atoms 	1 random 100 200093 safezone
Created 100 atoms
  using lattice units in orthogonal box = (0 0 0) to (50 50 50)
  create_atoms CPU = 0.001 seconds
mass 			* 12.01



#==========Velocity initialization==========
velocity 		all create 0.0000001 1563967 rot yes dist gaussian

#======Pair style for atom interactions=============
pair_style 		rebo
pair_coeff 		* * CH.rebo C
Reading rebo potential file CH.rebo with DATE: 2018-7-3

#==============Neighbor selection===================
neighbor 		0.3 bin
neigh_modify 	every 1 delay 0 check yes


#=====================Timestep======================
timestep 		${timestep}
timestep 		0.0001

#===============Define dump command=================
dump 			1 all cfg 100000 ./dump/dump.tensile_*.cfg mass type xs ys zs vx vy vz id

#========System temperature printing info===========
thermo_style 	custom step temp etotal epair pe ke
thermo 			${iexport}
thermo 			1000



#====================CRC Cycle======================

#=============Condensation et chauffe===============
fix 			1 all nve
fix 			2 all temp/berendsen 0.0 ${tempchauf} ${Tdamp}
fix 			2 all temp/berendsen 0.0 3000 ${Tdamp}
fix 			2 all temp/berendsen 0.0 3000 0.001
fix             3 all momentum 1 linear 1 1 1 angular rescale

run 			${iter}
run 			1000000
