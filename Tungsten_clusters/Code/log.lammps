  using 1 OpenMP thread(s) per MPI task
# LAMMPS input script to load a restart file and perform minimization

#============Initialization=================
units 			metal
boundary 		p p p
atom_style 		charge


# Read the restart file directly
read_data 	./endconf/bcc/endconf100001.data
Reading data file ...
  orthogonal box = (0 0 0) to (10.56 10.56 10.56)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  54 atoms
  reading velocities ...
  54 velocities
  read_data CPU = 0.032 seconds

#======Pair style for atom interactions=====
pair_style eam/fs
pair_coeff * * ../../potentials/w.eam2.fs W


############################################
#              CLI Variables               #
############################################
variable 		seed index 200093          #
variable 		N index 2000               #
variable 		iter index 10000000         # 1.0e6 => 1.0e-7 s
variable 		iterther index 1000000      # 1.0e5
variable 		iexport index 100000       # 1.0e5
variable 		tempchauf index 2000       #
variable 		Tdamp index 0.1            #
variable 		timestep index 0.0001	   #
variable 		box_size index 30		   #
############################################
############################################



# ---------- Run MD Heating ---------------------

fix              2 all nve
fix              3 all temp/berendsen  0.0 ${tempchauf} ${Tdamp}
fix              3 all temp/berendsen  0.0 2000 ${Tdamp}
fix              3 all temp/berendsen  0.0 2000 0.1
fix              4 all momentum 1 linear 1 1 1 angular rescale


timestep	${timestep}
timestep	0.0001


thermo 1000
thermo_style custom step  temp etotal epair ebond pe ke

dump 			1 all cfg ${iexport} ./dump/bcc_chauf_real_2000/dump.tensile_*.cfg mass type xs ys zs vx vy vz mass q id
dump 			1 all cfg 100000 ./dump/bcc_chauf_real_2000/dump.tensile_*.cfg mass type xs ys zs vx vy vz mass q id

dump_modify     1 element W

run				${iter}
run				10000000
